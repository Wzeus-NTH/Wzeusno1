--[[
	===========================================
	WZEUS HUB - HOÀN THIỆN THÔNG BÁO & DISCORD
	===========================================
	Cách dùng: Đặt LocalScript này vào StarterPlayerScripts.
	Giao diện sẽ tự động tạo và hiển thị ở giữa màn hình.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- screenGui setup (Chắc chắn không bị mất khi respawn)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "WZeusNotificationGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true -- Tránh bị lệch trên điện thoại
screenGui.Parent = playerGui

-- 1. Tạo Frame chính (Bảng thông báo)
local mainFrame = Instance.new("Frame")
mainFrame.Name = "NotifyFrame"
mainFrame.Size = UDim2.new(0, 520, 0, 280) -- Kích thước lớn, cân đối
mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 40) -- Nền tối hiện đại
mainFrame.BorderSizePixel = 0
mainFrame.ClipsDescendants = true
mainFrame.Parent = screenGui

-- Bo góc khung chính
local frameUICorner = Instance.new("UICorner")
frameUICorner.CornerRadius = UDim.new(0, 18)
frameUICorner.Parent = mainFrame

-- Viền Neon Tím (WZeus Style)
local uiStroke = Instance.new("UIStroke")
uiStroke.Thickness = 4.5
uiStroke.Color = Color3.fromRGB(148, 0, 211) -- Màu tím Violet đậm
uiStroke.Parent = mainFrame

-- 2. Tiêu đề
local titleLabel = Instance.new("TextLabel")
titleLabel.Name = "TitleLabel"
titleLabel.Size = UDim2.new(1, -60, 0, 50)
titleLabel.Position = UDim2.new(0, 30, 0, 15)
titleLabel.BackgroundTransparency = 1
titleLabel.TextColor3 = Color3.fromRGB(255, 215, 0) -- Màu vàng Gold
titleLabel.TextSize = 26
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextXAlignment = Enum.TextXAlignment.Center
titleLabel.Text = "⚡ WZEUS HUB ANNOUNCEMENT"
titleLabel.Parent = mainFrame

-- 3. Nội dung thông báo
local infoLabel = Instance.new("TextLabel")
infoLabel.Name = "InfoLabel"
infoLabel.Size = UDim2.new(1, -60, 0, 90)
infoLabel.Position = UDim2.new(0, 30, 0, 70)
infoLabel.BackgroundTransparency = 1
infoLabel.TextColor3 = Color3.fromRGB(230, 230, 230) -- Màu trắng sáng
infoLabel.TextSize = 17
infoLabel.Font = Enum.Font.Gotham
infoLabel.TextWrapped = true
infoLabel.TextXAlignment = Enum.TextXAlignment.Left
infoLabel.TextYAlignment = Enum.TextYAlignment.Top
-- Nội dung chính xác bạn yêu cầu:
infoLabel.Text = "Let me know if the WZeus Hub script is stable yet. Did you encounter any errors while using it? Tell me on Discord."
infoLabel.Parent = mainFrame

-- 4. Khu vực hiển thị Link Discord
local linkBox = Instance.new("TextBox")
linkBox.Name = "DiscordLinkBox"
linkBox.Size = UDim2.new(1, -60, 0, 40)
linkBox.Position = UDim2.new(0, 30, 0, 175)
linkBox.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
linkBox.TextColor3 = Color3.fromRGB(0, 255, 127) -- Màu xanh lá nổi bật
linkBox.TextSize = 16
linkBox.Font = Enum.Font.Code
-- Link Discord của bạn:
linkBox.Text = "https://discord.gg/vRtqV6C9s" 
linkBox.ClearTextOnFocus = false
linkBox.TextEditable = false -- Chỉ cho phép copy, không cho sửa
linkBox.Parent = mainFrame

local linkUICorner = Instance.new("UICorner")
linkUICorner.CornerRadius = UDim.new(0, 10)
linkUICorner.Parent = linkBox

-- 5. Nút DISCORD (Chính giữa phía dưới)
local discordBtn = Instance.new("TextButton")
discordBtn.Name = "DiscordButton"
discordBtn.Size = UDim2.new(0, 240, 0, 45)
discordBtn.AnchorPoint = Vector2.new(0.5, 0)
discordBtn.Position = UDim2.new(0.5, 0, 0, 222)
discordBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242) -- Màu xanh Discord chuẩn
discordBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
discordBtn.TextSize = 16
discordBtn.Font = Enum.Font.GothamBold
discordBtn.Text = "📋 Copy Link Discord"
discordBtn.Parent = mainFrame

local btnUICorner = Instance.new("UICorner")
btnUICorner.CornerRadius = UDim.new(0, 12)
btnUICorner.Parent = discordBtn

-- Hiệu ứng hover cho nút Discord
discordBtn.MouseEnter:Connect(function()
	TweenService:Create(discordBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(114, 137, 218)}):Play()
end)
discordBtn.MouseLeave:Connect(function()
	TweenService:Create(discordBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(88, 101, 242)}):Play()
end)

-- Sự kiện khi bấm nút Copy Link (Sử dụng setclipboard để tự động copy)
discordBtn.MouseButton1Click:Connect(function()
	-- Cố gắng thực hiện lệnh copy vào bộ nhớ tạm
	local success, err = pcall(function()
		setclipboard("https://discord.gg/vRtqV6C9s")
	end)
	
	if success then
		discordBtn.Text = "✅ Đã copy link!"
		linkBox.Text = "🎉 Link đã được sao chép! Hãy paste vào trình duyệt."
		task.wait(3) -- Hiển thị thông báo thành công 3 giây
		discordBtn.Text = "📋 Copy Link Discord"
		linkBox.Text = "https://discord.gg/vRtqV6C9s"
	else
		-- Trường hợp không copy được (trên một số executor bị chặn)
		warn("Không thể tự động copy. Vui lòng copy thủ công link ở trên.")
		discordBtn.Text = "⚠️ Copy thủ công!"
		linkBox.Text = "⚠️ Trình duyệt chặn tự động copy. Vui lòng bôi đen link và copy!"
	end
end)

-- 6. Nút ĐÓNG (X) ở góc trên bên phải
local closeBtn = Instance.new("TextButton")
closeBtn.Name = "CloseButton"
closeBtn.Size = UDim2.new(0, 40, 0, 40)
closeBtn.Position = UDim2.new(1, -50, 0, 12)
closeBtn.BackgroundColor3 = Color3.fromRGB(230, 50, 50) -- Nền đỏ
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.TextSize = 22
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Text = "X"
closeBtn.Parent = mainFrame

local closeUICorner = Instance.new("UICorner")
closeUICorner.CornerRadius = UDim.new(1, 0) -- Hình tròn hoàn hảo
closeUICorner.Parent = closeBtn

closeBtn.MouseEnter:Connect(function()
	TweenService:Create(closeBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 80, 80)}):Play()
end)
closeBtn.MouseLeave:Connect(function()
	TweenService:Create(closeBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(230, 50, 50)}):Play()
end)

-- Sự kiện bấm nút X để đóng bảng
local isClosing = false
closeBtn.MouseButton1Click:Connect(function()
	if isClosing then return end
	isClosing = true
	
	-- Hiệu ứng thu nhỏ khi đóng
	local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	local tween = TweenService:Create(mainFrame, tweenInfo, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0), Rotation = 360})
	tween:Play()
	tween.Completed:Wait() -- Chờ hiệu ứng chạy xong
	
	screenGui:Destroy() -- Xóa hẳn giao diện
end)

-- 7. Tùy chọn: Thêm phím tắt để ẩn/hiện bảng (Ví dụ: phím F9)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.F9 then
		if mainFrame.Visible then
			closeBtn.MouseButton1Click:Fire() -- Tự động gọi hàm đóng
		else
			-- Nếu muốn tạo lại khi bấm F9, cần copy đoạn tạo GUI vào đây
		end
	end
end)
