
local CoreGui = game:GetService("CoreGui")

-- Xóa bảng cũ nếu đã tồn tại để tránh trùng lặp
if CoreGui:FindFirstChild("ColorfulNoticeGui") then
	CoreGui.ColorfulNoticeGui:Destroy()
end

-- 1. Tạo ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ColorfulNoticeGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

-- 2. Khung chính (Main Frame)
local frame = Instance.new("Frame")
frame.Name = "MainFrame"
frame.Size = UDim2.new(0, 420, 0, 140)
frame.Position = UDim2.new(0.5, 0, 0.5, 0)
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.BackgroundColor3 = Color3.fromRGB(22, 22, 28) -- Nền tối hiện đại
frame.BorderSizePixel = 0
frame.Parent = screenGui

-- Bo tròn góc cho khung
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = frame

-- Viền ngoài màu vàng cam nổi bật
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 170, 0)
stroke.Thickness = 2
stroke.Parent = frame

-- 3. Tiêu đề / Header Bar (Màu vàng cam)
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -50, 0, 30)
titleLabel.Position = UDim2.new(0, 18, 0, 10)
titleLabel.BackgroundTransparency = 1
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Text = "⚠️ SYSTEM NOTICE"
titleLabel.TextColor3 = Color3.fromRGB(255, 185, 0) -- Chữ tiêu đề màu vàng cam
titleLabel.TextSize = 14
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Parent = frame

-- 4. Nội dung thông báo (Màu trắng sáng rõ nét)
local textLabel = Instance.new("TextLabel")
textLabel.Size = UDim2.new(1, -36, 0, 70)
textLabel.Position = UDim2.new(0, 18, 0, 45)
textLabel.BackgroundTransparency = 1
textLabel.Font = Enum.Font.GothamMedium
textLabel.Text = "Temporarily unavailable"
textLabel.TextColor3 = Color3.fromRGB(255, 255, 255) -- Chữ nội dung màu trắng tinh
textLabel.TextSize = 22
textLabel.TextWrapped = true
textLabel.Parent = frame

-- 5. Nút đóng [X]
local closeButton = Instance.new("TextButton")
closeButton.Name = "CloseButton"
closeButton.Size = UDim2.new(0, 30, 0, 30)
closeButton.Position = UDim2.new(1, -38, 0, 10)
closeButton.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
closeButton.BorderSizePixel = 0
closeButton.Font = Enum.Font.GothamBold
closeButton.Text = "✕"
closeButton.TextColor3 = Color3.fromRGB(220, 220, 230)
closeButton.TextSize = 15
closeButton.Parent = frame

-- Bo tròn nút X
local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 8)
btnCorner.Parent = closeButton

-- Hiệu ứng Rê chuột & Bấm nút X để tắt
closeButton.MouseEnter:Connect(function()
	closeButton.BackgroundColor3 = Color3.fromRGB(230, 50, 50) -- Đổi sang màu đỏ khi rê chuột
	closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
end)

closeButton.MouseLeave:Connect(function()
	closeButton.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	closeButton.TextColor3 = Color3.fromRGB(220, 220, 230)
end)

closeButton.MouseButton1Click:Connect(function()
	screenGui:Destroy() -- Đóng/xóa hoàn toàn bảng khi bấm X
end)

print("Đã tạo bảng thông báo có màu thành công!")
